# Compose will build the app container's DATABASE_URL from POSTGRES_* below,
# forcing the hostname to the Compose service name "db".
DATABASE_URL=postgresql+psycopg://employee_app:replace_with_a_local_uri_safe_password@db:5432/employee_platform

# Replace the password placeholder with a local development password.
# Use URI-safe characters because Compose embeds this value in DATABASE_URL.
POSTGRES_DB=employee_platform
POSTGRES_USER=employee_app
POSTGRES_PASSWORD=replace_with_a_local_uri_safe_password
POSTGRES_HOST_PORT=5432

# Replace with a long random secret before starting the application.
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Ollama stays on the Windows host; this hostname is available in Docker Desktop.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
